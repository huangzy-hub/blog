---
import { Icon } from "astro-icon/components";

import type { SeriesGroup } from "@utils/content";
import { getPostUrl, getSeriesUrl } from "@utils/url";


interface Props {
    series: SeriesGroup;
    currentPostId: string;
}

const { series, currentPostId } = Astro.props;
const currentIndex = series.posts.findIndex(post => post.id === currentPostId);
---

<details class="series-panel mb-6 rounded-xl overflow-hidden" open>
    <summary class="cursor-pointer select-none px-4 py-3 flex items-center gap-3">
        <span class="h-9 w-9 shrink-0 rounded-lg bg-[var(--enter-btn-bg)] flex items-center justify-center text-[var(--primary)]">
            <Icon name="material-symbols:collections-bookmark-outline-rounded" class="text-2xl" />
        </span>
        <span class="min-w-0 flex-1">
            <span class="block text-xs text-50">所属合集</span>
            <span class="block font-bold text-90 truncate">{series.name}</span>
        </span>
        <span class="text-sm text-50 whitespace-nowrap">
            第 {currentIndex + 1} / {series.posts.length} 篇
        </span>
    </summary>

    <ol class="px-3 pb-3 flex flex-col gap-1">
        {series.posts.map((post, index) => {
            const isCurrent = post.id === currentPostId;
            return (
                <li>
                    <a
                        href={getPostUrl(post)}
                        aria-current={isCurrent ? "page" : undefined}
                        class:list={[
                            "flex items-center gap-3 rounded-lg px-3 py-2 transition",
                            isCurrent
                                ? "bg-[var(--primary)] text-white dark:text-black/80"
                                : "btn-plain text-75 hover:text-[var(--primary)]",
                        ]}
                    >
                        <span class:list={[
                            "w-7 h-7 shrink-0 rounded-full flex items-center justify-center text-xs font-bold",
                            isCurrent ? "bg-white/20" : "bg-[var(--enter-btn-bg)] text-[var(--primary)]",
                        ]}>
                            {post.data.seriesOrder ?? index + 1}
                        </span>
                        <span class="font-medium truncate">{post.data.title}</span>
                        {isCurrent && <span class="ml-auto shrink-0 text-xs">正在阅读</span>}
                    </a>
                </li>
            );
        })}
    </ol>

    <div class="px-4 pb-4 text-right">
        <a href={getSeriesUrl(series.name)} class="link-lg text-sm font-medium">
            查看合集详情
            <Icon name="material-symbols:arrow-forward-rounded" class="inline text-lg align-middle" />
        </a>
    </div>
</details>

<style>
    .series-panel {
        border: 1px solid var(--line-divider);
        background: color-mix(in oklch, var(--primary), transparent 96%);
    }

    .series-panel summary::marker {
        color: var(--primary);
    }
</style>
