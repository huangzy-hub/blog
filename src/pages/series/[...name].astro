---
import { Icon } from "astro-icon/components";
import type { CollectionEntry } from "astro:content";

import { getSeriesList, type SeriesGroup } from "@utils/content";
import { getPostUrl } from "@utils/url";
import { formatDateToYYYYMMDD } from "@utils/date";
import GridLayout from "@layouts/grid.astro";
import BackwardButton from "@components/backwardButton.astro";


export async function getStaticPaths() {
    const seriesList = await getSeriesList();
    return seriesList.map(series => ({
        params: { name: series.name },
        props: { series },
    }));
}

interface Props {
    series: SeriesGroup;
}

const { series } = Astro.props;
const pageDescription = `共 ${series.posts.length} 篇文章，按合集顺序阅读。`;
---

<GridLayout title={series.name} description={pageDescription}>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-6 md:px-9 py-6 relative w-full">
            <BackwardButton currentPath={Astro.url.pathname} />
            <header class="mb-8">
                <div class="flex items-center gap-3 text-[var(--primary)] mb-3">
                    <Icon name="material-symbols:collections-bookmark-outline-rounded" class="text-3xl" />
                    <span class="font-medium">文章合集</span>
                </div>
                <h1 class="text-3xl font-bold text-neutral-900 dark:text-neutral-100 mb-3">{series.name}</h1>
                <p class="text-neutral-600 dark:text-neutral-400">{pageDescription}</p>
            </header>

            <ol class="relative flex flex-col gap-3">
                {series.posts.map((post: CollectionEntry<"posts">, index) => (
                    <li>
                        <a
                            href={getPostUrl(post)}
                            class="series-post group flex items-start gap-4 rounded-xl border p-4 md:p-5 transition-all"
                        >
                            <span class="h-10 w-10 shrink-0 rounded-full bg-[var(--enter-btn-bg)] text-[var(--primary)] flex items-center justify-center font-bold group-hover:bg-[var(--primary)] group-hover:text-white dark:group-hover:text-black/80 transition">
                                {post.data.seriesOrder ?? index + 1}
                            </span>
                            <span class="min-w-0 flex-1">
                                <span class="block font-bold text-lg text-90 group-hover:text-[var(--primary)] transition-colors">
                                    {post.data.title}
                                </span>
                                {post.data.description && (
                                    <span class="block text-sm text-50 mt-1 line-clamp-2">{post.data.description}</span>
                                )}
                                <span class="block text-xs text-30 mt-2">
                                    {formatDateToYYYYMMDD(post.data.published)}
                                </span>
                            </span>
                            <Icon name="material-symbols:chevron-right-rounded" class="text-3xl text-[var(--primary)] shrink-0 mt-1 transition-transform group-hover:translate-x-1" />
                        </a>
                    </li>
                ))}
            </ol>
        </div>
    </div>
</GridLayout>

<style>
    .series-post {
        border-color: var(--line-divider);
        background: color-mix(in oklch, var(--card-bg), transparent 8%);
    }

    .series-post:hover {
        border-color: var(--primary);
        background: color-mix(in oklch, var(--primary), transparent 95%);
        transform: translateX(3px);
    }
</style>
