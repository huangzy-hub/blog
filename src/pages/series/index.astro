---
import { Icon } from "astro-icon/components";

import { getSeriesList } from "@utils/content";
import { getSeriesUrl } from "@utils/url";
import { formatDateToYYYYMMDD } from "@utils/date";
import GridLayout from "@layouts/grid.astro";
import BackwardButton from "@components/backwardButton.astro";


const seriesList = await getSeriesList();
const pageTitle = "文章合集";
const pageDescription = "按主题整理的系列文章，适合从第一篇开始连续阅读。";
---

<GridLayout title={pageTitle} description={pageDescription}>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-6 md:px-9 py-6 relative w-full">
            <BackwardButton currentPath={Astro.url.pathname} />
            <header class="mb-8">
                <h1 class="text-3xl font-bold text-neutral-900 dark:text-neutral-100 mb-3">{pageTitle}</h1>
                <p class="text-neutral-600 dark:text-neutral-400">{pageDescription}</p>
            </header>

            {seriesList.length > 0 ? (
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    {seriesList.map(series => {
                        const latestPost = series.posts.reduce((latest, post) =>
                            (post.data.updated || post.data.published) > (latest.data.updated || latest.data.published)
                                ? post
                                : latest,
                        );

                        return (
                            <a
                                href={getSeriesUrl(series.name)}
                                class="series-card group rounded-xl border p-5 transition-all duration-300"
                            >
                                <div class="flex items-start gap-4">
                                    <div class="h-12 w-12 shrink-0 rounded-xl flex items-center justify-center text-[var(--primary)] bg-[var(--enter-btn-bg)] group-hover:bg-[var(--primary)] group-hover:text-white dark:group-hover:text-black/80 transition">
                                        <Icon name="material-symbols:collections-bookmark-outline-rounded" class="text-3xl" />
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <h2 class="font-bold text-xl text-90 group-hover:text-[var(--primary)] transition-colors line-clamp-2">
                                            {series.name}
                                        </h2>
                                        <p class="text-sm text-50 mt-2">
                                            {series.posts.length} 篇文章 · 更新于 {formatDateToYYYYMMDD(latestPost.data.updated || latestPost.data.published)}
                                        </p>
                                    </div>
                                    <Icon name="material-symbols:chevron-right-rounded" class="text-3xl text-[var(--primary)] shrink-0 transition-transform group-hover:translate-x-1" />
                                </div>
                                <div class="mt-4 pt-4 border-t border-[var(--line-divider)] text-sm text-50 truncate">
                                    最新：{latestPost.data.title}
                                </div>
                            </a>
                        );
                    })}
                </div>
            ) : (
                <div class="py-16 text-center text-50">
                    <Icon name="material-symbols:collections-bookmark-outline-rounded" class="text-5xl mx-auto mb-3" />
                    <p>还没有创建文章合集</p>
                </div>
            )}
        </div>
    </div>
</GridLayout>

<style>
    .series-card {
        border-color: var(--line-divider);
        background: color-mix(in oklch, var(--card-bg), transparent 8%);
    }

    .series-card:hover {
        border-color: var(--primary);
        background: color-mix(in oklch, var(--primary), transparent 95%);
        transform: translateY(-3px);
        box-shadow: 0 10px 24px color-mix(in oklch, var(--primary), transparent 88%);
    }
</style>
